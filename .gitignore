# Godot 4+ specific ignores
.godot/
.import/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores (we use GDScript, but just in case)
.mono/
data_*/
mono_crash.*.json

# Build / export artifacts(/build/ 见下方开发产物一节)
/export/
/android/          # Android gradle build template (200MB+, install from Godot 编辑器: 项目→安装Android构建模板)
*.apk
*.pck
*.zip

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo

# ── 开发产物(2026-11-02 收拢, 方案书 docs/plans/20261102-文件管理与发版流程重整.md F3) ─────────
#   现行落点: /.out/(截图 / 特效实验台 / 门禁失败日志 / 对比图; scripts/util/dev_out.gd)。点目录, Godot 不导入。
#   清理: python tools/clean.py(默认只列), --apply 才删。
/.out/
#   旧落点: 根目录 _*(截图、实验台、连拍) —— 只锚根目录。
#   原来写的是不带 / 的 _*.png, 把 assets/sprites/equip/_axe-base-steel.png(tools/axe_palette.py 要读)也藏了。
/_*
#   文档里的生成草稿(docs/plans/ref/_gen_wood_try1.png 等)照旧不进仓
docs/**/_*
/build/
!/build/.gdignore
vfx_preview.png
vfx_slash*.png
tri_audit_report.txt

# ── Python (tools/ 下 19 个脚本) ──────────────────────────────────────────────
#   2026-07-20: tools/__pycache__/*.pyc 曾被误提交进仓库(此前无任何 python 忽略规则)。
__pycache__/
*.py[cod]

# ── 工具产物 ─────────────────────────────────────────────────────────────────
#   注意: tools/hp_s*_report.txt 是【有意跟踪】的 —— 它们既是同步轮次留痕,
#   hp_staleness_check.py 还要读它们的 mtime 判断新鲜度。别加进忽略。
#   这里只忽略无留痕价值的即时审计输出。
tooltip_number_audit_report.txt
data_integrity_report.txt

# 队列模拟产物(可再生·5MB+): 快照池/逐场CSV/报告。种子池成品在 data/ghost_seed.json
tools/autoplay/

# 对局CSV被 Godot 当翻译表导入生成的 .translation(可再生·每轮 72 个)。
# 旧轮次 tools/duel/ 也是这样, 只是从没被跟踪 —— 这里写明, 免得下次又被 git status 刷屏。
tools/duel*/*.translation

# ★对局模拟的【原始产物本身】也不跟踪(可再生·每轮 12 shard × CSV + log)。
#   原来只忽略了 .translation, CSV/log 是"未跟踪但未忽略" —— 于是 `git add -A`
#   会把它们一把扫进提交(我 2026-07-30 就这么污染了一次提交, 145 个无关文件)。
#   留痕价值在【结论】(平衡表/CHANGELOG/方案书), 不在逐场 CSV。
tools/duel*/duel-*.csv
tools/duel*/duel-*.csv.import
tools/duel*-log/

# Claude Code 本地权限设置(每台机器不同, 不进版本库)
.claude/settings.local.json
.dyebak

# Godot --import 跑到一半留下的中间文件; git add -A 会把它们一起收走(2026-08-20 误提交过两个)
*.tmp

# 本地运行垃圾(2026-10-22 收尾): 某次测试的 user:// 落点 / Sideloadly 装机日志(根目录 _show/ 已由 /_* 管)
#   门禁失败日志 2026-11-02 起在 /.out/gate/; 旧的根目录 .gate-fail-*.log 用 tools/clean.py --apply 清
/Godot/
sideloadlydaemon.log
.gate-fail-*.log
