extends RefCounted
class_name DetScenarios
## _det_scenarios.gd — 确定性门禁的**场景表，全仓唯一一份**
##
## ══════════════════════════════════════════════════════════════════════
##  为什么抽出来
## ══════════════════════════════════════════════════════════════════════
## 2026-09-26 加第二个消费者时抽的。两个门禁吃同一张表：
##   · `verify_determinism_b`      —— 同种子**同进程**两遍，逐步指纹必须逐字相同
##   · `verify_determinism_cross`  —— 逐步指纹压成一个摘要，与**钉住的金标**比
##     ⇒ 本地(Windows/MSVC libm) 与 CI(Linux/glibc) 跑同一份金标 ⇒
##       对得上就是**跨平台逐位一致**，对不上就报第一个分叉步。
##
## 原稿（`docs/design/斗龟场大轮赛制方案v2-用户原稿.md` §五.1）：
##   「**确定性模拟是全部前提**：同种子 + 同双方阵容摆位 ⇒ 必然同结果…
##     禁用依赖帧率/浮点平台差异的逻辑…此项排期在赛制上线之前。」
## 周日要做成「服务端结算一次 + 双方各看同一份重放」，这张表就是那条前提的尺子。
##
## ★抄第二份的代价是实打实的（memory `fb-hand-rolled-copies-drift`）：
##   场景里那些"为什么摆这个距离/为什么点这个技能"的理由一旦分家，
##   下一个人改其中一份，另一份就静静地变成空跑。所以**表和它的理由在一起**。
## ══════════════════════════════════════════════════════════════════════

## 一条 = {tag, pairs, frames, seed, loadouts}
## pairs 每项 = [turtle_id, side, x, y, [装备 id…]]
##   `"__minion__:front"` / `":back"` = 小将，前后排由笔刷字段决定
static func all() -> Array:
	var bare3: Array = [
		["stone", "left", 320.0, 220.0, []], ["basic", "left", 320.0, 320.0, []],
		["ninja", "left", 320.0, 420.0, []],
		["lightning", "right", 900.0, 220.0, []], ["dice", "right", 900.0, 320.0, []],
		["pirate", "right", 900.0, 420.0, []]]
	return [
		## ① 基线: 两只裸装
		{"tag": "① 2 单位裸装", "frames": 200, "seed": "424242", "loadouts": {}, "pairs": [
			["basic", "left", 320.0, 300.0, []],
			["basic", "right", 400.0, 300.0, []]]},

		## ② ★抓到 bug 的那一局: 海盗(登场轰击挂 tween 末尾) + 忍者(冲刺吃真实 delta)
		##    + 骰子(吃 _battle_rng)
		{"tag": "② 3v3 裸装(海盗/忍者/骰子/闪电)", "frames": 600, "seed": "424242",
			"loadouts": {}, "pairs": bare3},

		## ③ 满装备: 每只 3 件 3★, 覆盖召唤/弹道/周期/羁绊多条路径
		{"tag": "③ 3v3 满装备(每只 3 件 3★)", "frames": 600, "seed": "424242",
			"loadouts": {}, "pairs": [
			["stone", "left", 320.0, 220.0, ["p2eq_001", "p2eq_010", "p2eq_022"]],
			["basic", "left", 320.0, 320.0, ["p2eq_032", "p2eq_058", "p2eq_073"]],
			["ninja", "left", 320.0, 420.0, ["p2eq_061", "p2eq_084", "p2eq_091"]],
			["lightning", "right", 900.0, 220.0, ["p2eq_006", "p2eq_009", "p2eq_026"]],
			["dice", "right", 900.0, 320.0, ["p2eq_065", "p2eq_070", "p2eq_077"]],
			["pirate", "right", 900.0, 420.0, ["p2eq_080", "p2eq_087", "p2eq_094"]]]},

		## ④ 双头/藏身(小将踩背)/宽刃扫描 —— 都是"协程按真实 delta 推进"的同族站点
		{"tag": "④ 双头/藏身/宽刃(协程位移同族)", "frames": 1000, "seed": "424242",
			"loadouts": {}, "pairs": [
			["two_head", "left", 320.0, 240.0, ["p2eq_009"]],
			["hiding", "left", 320.0, 380.0, []],
			["gambler", "right", 900.0, 240.0, []],
			["basic", "right", 900.0, 380.0, []]]},

		## ⑤ 剑线装备: 007 锈蚀阔剑(每 6 秒)与 006 千刃风暴(每 7 秒) —— 推进都写在
		##    `await process_frame` 协程里(equip_system.gd:948 / :1303), 原来按真实 delta 走。
		##    1400 步 = 23.3 游戏秒 ⇒ 两件都至少触发一次(6s / 7s), 不然这一条是空跑。
		## ★携带者用【远程】猎人: 近战龟会贴到脸上, 剑气墙一出生就命中 ⇒ 到达时刻没有可观测
		##   差异, 把"推进用哪条钟"整条藏起来(改坏了门禁也不红)。拉开距离才量得到。
		{"tag": "⑤ 007阔剑+006千刃(协程扫描同族)", "frames": 1400, "seed": "424242",
			"loadouts": {}, "pairs": [
			["hunter", "left", 320.0, 300.0, ["p2eq_007", "p2eq_006"]],
			["basic", "right", 900.0, 300.0, []],
			["basic", "right", 980.0, 380.0, []]]},

		## ⑥ 小将: 近战浪板的"踩背滑行 0.833 秒"与远程火箭的"慢速追踪导弹"都是协程位移
		##    (hiding_system.gd:107 / :345 / :376) —— 它们改的是**攻守双方**的 pos,
		##    分叉会立刻进指纹。
		{"tag": "⑥ 小将浪板/追踪火箭(协程位移)", "frames": 800, "seed": "424242",
			"loadouts": {}, "pairs": [
