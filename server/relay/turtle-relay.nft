#!/usr/sbin/nft -f
# 大陆中转 · 按来源 IP 的连接限速（README「速率」）。独立的表, 不碰 ufw(iptables-nft)那几张表, 也不 flush ruleset。
# 装: install -m 644 turtle-relay.nft /etc/turtle-relay.nft && systemctl enable --now turtle-relay-nft.service
# 撤: systemctl disable --now turtle-relay-nft.service(ExecStop 删掉本表)
#
# 端口: 第一阶段只管 8443(只有中转在用)。cn 上线后中转与 stream 同在 443 ⇒ 把 443 加进 relay_ports(README「切 DNS」)。
# 口径: 每个来源 IP 新建 TCP 连接 ≤ 20 个/秒(可突发 60), 同时在用的连接 ≤ 64 个; 超了直接丢新连接(已建立的连接不受影响)。
#   客户端是 HTTP/1.1 长连接, 正常玩一次只开几个连接; 大陆运营商大 NAT 下很多玩家共用一个出口 IP ⇒ 阈值放宽。

table inet turtle_relay
delete table inet turtle_relay

table inet turtle_relay {
	set relay_ports {
		type inet_service
		elements = { 8443 }
	}

	set conn_rate4 {
		type ipv4_addr
		flags dynamic, timeout
		timeout 1m
	}

	set conn_rate6 {
		type ipv6_addr
		flags dynamic, timeout
		timeout 1m
	}

	chain input {
		type filter hook input priority -5; policy accept;
		tcp dport @relay_ports ct state new add @conn_rate4 { ip saddr limit rate over 20/second burst 60 packets } counter drop
		tcp dport @relay_ports ct state new add @conn_rate6 { ip6 saddr limit rate over 20/second burst 60 packets } counter drop
		tcp dport @relay_ports ct state new meter conn_cnt4 { ip saddr ct count over 64 } counter drop
		tcp dport @relay_ports ct state new meter conn_cnt6 { ip6 saddr ct count over 64 } counter drop
	}
}
