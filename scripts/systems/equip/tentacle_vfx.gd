##     +10→+20     0.327→0.166      （长尾收回）
##   我做过的错版：前摇缩短、+0 只到 0.251、+1~+9 恒定 0.521（**定格 8 帧**）。
func _arc_for(t: Dictionary, stt: int) -> float:
	var reach_arc: float = ARC_LEN            # ★弧长恒定（= ATTACK_LEN），鞭子不会变长
	match stt:
		ST_EMERGE, ST_IDLE, ST_RETRACT:
			return ARC_LEN * IDLE_ARC_K       # 2026-11-13: 待机短身(LoL 实机), 拍下才甩长
		ST_WARN:
			## ★2026-11-13: 蓄力时缩短(实机蓄力不长高; 原来弧长恒定 9.6 ⇒ 松开卷曲就立成一根 9.6 米的杆子)
			var wk: float = smoothstep(0.0, 1.0, clampf(float(t["ts"]) / T_WARN, 0.0, 1.0))
			if wk >= 0.0:
				return ARC_LEN * lerpf(IDLE_ARC_K, REAR_ARC_K, wk)
			# ★弧长跟着【两次起伏】走：立钩 ×1.45 → 摊平 ×1.10 → 再立起卷环 ×1.55
			var wq: float = clampf(float(t["ts"]) / T_WARN, 0.0, 1.0)
			# ★官方摊平段(f024~f036)面积**回落到待机的 0.72~0.75 倍** —— 是缩小不是涨。
			#   我原来给 ×1.10 ⇒ 摊平时反而是一大团胖云朵，画面上比待机还显眼。
			# ★弧长恒定之后这里【不再放大长度】——原倍率(×1.0~1.55)是基于短 ARC_LEN 定的，
			#   现在 ARC_LEN 已经等于攻击长度，再乘就超出射程了。
			#   预警期的"长大/摊平"改由**卷曲量**表达（见 `_phase` 的 ST_WARN）。
			return ARC_LEN
		ST_REAR:
			return ARC_LEN * REAR_ARC_K   # 2026-11-13: 蓄力保持短身(见 ST_WARN)
		ST_SLAM:
			## 2026-11-13: 拍下时甩回全长 —— 在贴地之前(拍击曲线自己的时间 STRETCH_T 内)甩满; 点刺不缩不甩
			if float(t["share"]) < 0.9:
				return ARC_LEN
			var lt: float = maxf(float(t["ts"]) - SLAM_HOLD, 0.0) * SLAM_SPEED
			return ARC_LEN * lerpf(REAR_ARC_K, 1.0, smoothstep(0.0, 1.0, clampf(lt / STRETCH_T, 0.0, 1.0)))
		ST_RECOVER:
			## 2026-11-13: 收回时从全长缩回待机短身(LoL 实机: 梢端先抬起卷回, 身子收短)
			return ARC_LEN * lerpf(1.0, IDLE_ARC_K, smoothstep(0.0, 1.0, clampf(float(t["ts"]) / T_RECOVER, 0.0, 1.0)))
	return ARC_LEN


## 某一段的【切角】。从 `_rebuild` 拆出来 —— 那个函数第三次撞架构预算 250 行上限。
##
## ★★★这里集中了三条"真实物理"的实现，每条都是量出来才发现做错的：
##   ① **逐段时间滞后**（用户："真正的触手不应该是中下部发力带动全身吗"）——
##      整条共用同一时刻的参数只能弯出单调曲线，那是被掰弯的棍子。
##      让每段比根部晚 `u × WHIP_LAG` 秒收到发力，同一时刻不同段处在不同阶段 ⇒ S 形。
##      ⚠ **只在非拍击态生效**：官方拍击时是一条绷直的光带（实测曲率变号 0 次），
##        且滞后的时间尺度与**余振周期**同量级，开在拍击上会把端点的余振抹平。
##   ② **`cfrom` 连续化** —— 原来是 `0.30 if 待机/预警 else 0.68` 的硬切，
##      实测收回期投影卡在 0.294 不收、**进待机那一刻突然掉到 0.247**。
##   ③ **`wavy` 连续化** —— 原来 `0.0 if SLAM else 1.0`，摆动一帧内从有到无，
##      7° 扰动沿 36 段累加，是 REAR→SLAM 跳变的真凶之一。
## 曲率密度 κ(u) —— 每单位弧长转多少度。角度是它沿长度的积分。
##
## ★主包：把旧模型的 `curl × cu²` 换成它的导数形式（形状等价，但现在是"密度"，
##   可以再叠别的项而不互相干扰）。
## ★行波包：**余振**。一个曲率脉冲从根部(u=0)传到梢端(u=1)、幅度指数衰减。
##   这是"拍两次"的正解 —— 旧模型让整条一起卷回来，所以看着像第二次拍击；
##   脉冲只让**局部**弯一下，端点小幅摆动，读起来是甩出去之后的余振。
func _curvature(t: Dictionary, stt: int, u: float, curl_u: float, cfrom: float) -> float:
	# 主包：d/du [ curl × ((u-cfrom)/(1-cfrom))² ]，u < cfrom 时为 0
	var k: float = 0.0
	if u > cfrom:
		var cu: float = (u - cfrom) / (1.0 - cfrom)
		k = 2.0 * curl_u * cu / (1.0 - cfrom)
	## ★2026-11-13 螺旋钩头(照 LoL 实机待机「?」形, 顶端卷成螺旋): 只在最后约 28% 身长多卷 HOOK_EXTRA,
	##   权重按「卷了多少」算(卷曲 ≥ CURL_TIGHT 满额, ≤ 100 为 0) —— 卷紧的待机 / 出土末 / 收回末有钩, 张开、蓄力末、拍击自然没有;
	##   卷曲量本身连续, 这一项跟着连续, 状态切换不跳。
	var hk: float = clampf((curl_u - 100.0) / (CURL_TIGHT - 100.0), 0.0, 1.0)
	k += HOOK_EXTRA * hk * smoothstep(0.72, 1.0, u)
	# 行波包：只在拍击/收回期
	# ★★行波【不在拍击期开】：脉冲经过中段会把梢端顶高 ——
	#   实测 SLAM/0.05 高度 0.681 被顶回 0.771，那就是用户看到的第二次拍击。
	#   拍下去必须是**单调下落**。余振留给收回期（那时抬一点无所谓）。
	if stt == ST_RECOVER:
		var tt: float = float(t["ts"]) + (T_SLAM if stt == ST_RECOVER else 0.0)
		var wc: float = tt / RING_TRAVEL                 # 脉冲中心沿 u 移动
		if wc < 1.35:
			# ★★★必须是【正负成对】的偶极子，不能是单个正脉冲：
			#   曲率的积分是**累积转角**，单个正脉冲经过之后累积值一直挂在高位 ⇒
			#   那不是"局部弯一下"，是"从这点起整条都多转了一个角"。
			#   探针实测：ts=0.10 时相邻段中点距离掉到 0.022（正常 0.265）——
			#   触手在脉冲处急转到几乎折回，量出来的弧长从 9.33 掉到 7.65。
			#   ⇒ 一正一负，净转角 ≈ 0：只在局部拱出一个 S 弯，整体走向不变。
			#     这正是真实鞭子波的形态（弯过去再弯回来）。
			var d1: float = (u - wc) / RING_WIDTH
			var d2: float = (u - wc + RING_WIDTH * 1.5) / RING_WIDTH
			k += RING_AMP * (exp(-d1 * d1) - exp(-d2 * d2)) * exp(-tt * RING_DECAY)
	return k


func _seg_angle(t: Dictionary, stt: int, u: float, ts_now: float,
		swayt: float, kacc: float) -> Array:
	## ★★2026-08-21 句7(用户「拍击时触手没有很柔软的弯曲…这样是不行的」, 选 (b) 连砸下去也柔软):
	##   逐段滞后是**唯一能造 S 形**的机制, 2026-08-05 为修「拍下去两次」把它在拍击期关死了。
	##   现在重新打开(取一半幅度) —— 而"不许拍两次"改由**新判据**守:
	##   `verify_tentacle_soft` 断言【梢端高度在下砸期单调不上升】。
	##   ★当年"拍两次"的真因不是 S 形本身, 是梢端在下压过程中**往回抬**; 盯住高度即可,
	##     不必禁止柔软(禁曲率变号 = 禁 S 形 = 禁柔软, 是把孩子和洗澡水一起倒了)。
	## ★行波前沿(见文件头 SLAM_FRONT_SPAN 的长注释)。拍击期每段的局部时间 =
	##   全局时间 − 前沿到达本段的时刻; 未被扫到的段局部时间为负 ⇒ 保持前摇姿态。
	var lag_u: float
	if stt == ST_SLAM:
		## 行波前沿随拍击曲线一起加速(否则梢端还按原速晚到, 贴地落在 T_TOUCH 之后)
		lag_u = T_SLAM * SLAM_FRONT_SPAN * pow(u, SLAM_FRONT_P) / (SLAM_SPEED if float(t["share"]) >= 0.9 else 1.0)
	elif stt == ST_WARN or stt == ST_REAR:
		## ★抬起同样是行波(用户 2026-08-21)。未被前沿扫到的段局部时间为负 ⇒
		##   `_phase_at(ST_WARN)` 的 `wp` clamp 到 0 ⇒ 保持待机姿态, 与 IDLE 边界天然连续。
		lag_u = T_WARN * WARN_FRONT_SPAN * pow(u, WARN_FRONT_P)
	else:
		lag_u = u * WHIP_LAG
	var ph_u: Array = _phase_at(t, ts_now - lag_u)
	var a0u: float = float(ph_u[1])
	var a1u: float = float(ph_u[2])
	var curl_u: float = float(ph_u[3])
	var ang: float = lerpf(a0u, a1u, pow(u, 1.05))
	var cfrom: float = lerpf(CURL_FROM_CURLY, CURL_FROM,
		clampf(1.0 - curl_u / CURL_TIGHT, 0.0, 1.0))
	# ══════════════════════════════════════════════════════════════
	#  ★★★曲率密度模型（2026-08-05 换掉"整条一个卷曲量"）
	# ══════════════════════════════════════════════════════════════
	# 用户：「肯定是模型上得想办法」。旧模型是 `ang -= curl × cu²` ——
	# **一个标量 `curl` 控制整条**，于是：
	#   动态范围大 ⇒ 整条一起卷回来 = 用户看到的"拍下去两次"
	#   动态范围小 ⇒ 后段几乎不动（实测比官方平 8 倍）
	# 两者不可兼得，因为它没有"局部"这个自由度。
	#
	# 新模型：**曲率沿长度分布**，角度是它的累积积分。
	#   ang(u) = 基准角(u) − ∫₀^u κ(s) ds
	#   κ 由两个高斯包叠加：
	#     · 主包 —— 控制整体姿态（待机的钩 / 拍击的直），中心在中后段
	#     · 行波包 —— **余振**：一个曲率脉冲从根部传到梢端并衰减
	#       ⇒ 端点只是小幅摆动，不会整条卷回 ⇒ 有余振但不是"第二次拍击"
	#   这也天然表达了"中下部发力带动全身"：脉冲经过哪一段，哪一段就弯。
	# ⚠ 积分必须【沿段增量累积】，不能每段从头重积一次：
	#   我第一版每段用 `steps = int(u*24)` 重新积分，步长随 u 变 ⇒ **数值误差随 u 漂**，
	#   实测弧长从 9.33 掉到 7.62（门禁 ④b 立刻红）。
	#   现在由调用方传入上一段的累积值，本段只加自己这一小段的贡献。
	kacc += _curvature(t, stt, u, curl_u, cfrom) / float(SEG)
	## 松开按「离拍下行波前沿到达本段还有多久」算; 前摇期也按这把尺子(否则松开从拍下第 0 帧才起, 切换处一跳)
	var tl_lean: float = ts_now - lag_u
	## 2026-11-13: 拍击先 hold SLAM_HOLD 秒 ⇒ 松开也按同一把尺子往后推(点刺不 hold)
	if stt == ST_SLAM and float(t["share"]) >= 0.9:
		tl_lean -= SLAM_HOLD
	if stt == ST_REAR:
		tl_lean = ts_now - T_REAR - SLAM_HOLD - T_SLAM * SLAM_FRONT_SPAN * pow(u, SLAM_FRONT_P) / SLAM_SPEED
	var lean_k: float = _lean_back(stt, tl_lean) / LEAN_DEG
	## 往后折的同时把往前勾的卷曲收掉(用户 11-01「最顶端…还是往前面吊着的」)
	## 2026-11-13: 0.9 → 0.35 —— LoL 实机抡到身后时钩头一直卷着(原来几乎全收掉 = 一根直杆)
	ang -= kacc * (1.0 - 0.35 * lean_k)
	## ★2026-11-01 用户「抬起是出手根部带动上部…最末端应该是往后仰…猛拍…同样的是有个先从下到上抽动的这个顺序…跟鞭子一样」:
	##   出手改走跟随(不再跑会抽的链式模拟)之后, 惯性拖尾不会自己长出来 ⇒ 画进目标姿势(见 LEAN_DEG)。
	## 弧: 从底到顶每段多转一点 ⇒ 整根往后弯成一条弧(LEAN_P = 1 是等曲率)。
	##   用户 11-01「他整个是一个弯起来的，向后弯起来的呀。从底部到顶部，整个是向后，有点带着弯起来的」
	ang += LEAN_DEG * lean_k * pow(u, LEAN_P)
	## ★★2026-08-22 换成链式模拟之后, 这里**只剩"指定姿势"(肌肉的目标)**。
	##   原来叠在这儿的两个手写项已删:
	##     · 惯性拖尾弹簧 `lag * u^p`  —— 模拟的 Verlet 积分自带惯性, 留着是双重计算
	##     · 重力垂头 `GRAV_K * sin(...)` —— 模拟里每个节点受真重力, 留着同样是双重
	##   **让物理去长这些东西, 不要在目标姿势里预先画好。**
	var wavy: float = 1.0
	if stt == ST_SLAM:
		## ★2026-08-21 句7: 原来拍击期把摆动**压到 0**(整条锁死在一个竖直平面)。
		##   现在留一个地板值 SLAM_WAVY_MIN —— 砸下去仍有轻微横摆, 不再像一根铁棍。
		wavy = maxf(SLAM_WAVY_MIN, 1.0 - clampf(float(t["ts"]) / SNAP_T, 0.0, 1.0))
	var yaw: float = deg_to_rad(_sway_amp(t, stt) * sin(u * TAU * 0.6 + swayt) * wavy)
	# ★主干的波浪起伏 —— 逐帧看官方 idle，主干【不是光滑的弧】，
	#   沿长度有明显的一波一波（像水流）。叠在切角上，幅度不大但读得出来。
	ang += 7.0 * wavy * sin(u * TAU * 2.1 + swayt * 1.7)
	return [ang, yaw, curl_u, kacc]


## 待机侧摆的权重(0..1): 进待机 IDLE_BLEND 秒渐入; 预警头 0.35 秒从进预警那一刻的权重渐出; 其余 0。
func _sway_k(t: Dictionary, stt: int) -> float:
	var ts: float = float(t["ts"])
	if stt == ST_IDLE:
		return smoothstep(0.0, IDLE_BLEND, ts)
	if stt == ST_WARN:
		return float(t.get("sway_k0", 0.0)) * (1.0 - smoothstep(0.0, 0.35, ts))
	return 0.0


func _sway_amp(t: Dictionary, stt: int) -> float:
	return lerpf(S_AMP, S_AMP_IDLE, _sway_k(t, stt))


## 上半截后仰量(度): 跟着抬起猛弯到 LEAN_FAST(三次缓出), 到顶后蓄力再慢慢加满, 到拍下那刻最满(用户 11-01「从抬头到劈下去…不连贯不自然」: 原来前 45% 弯完就定住 0.6 秒) → 前摇满额 → 拍下时本段在行波前沿到达前 0.08 秒起松开、到达后 0.02 秒松完(从后面甩回来路程长, 晚松会让落地晚于伤害帧)。tl = 本段的局部时间。
func _lean_back(stt: int, tl: float) -> float:
	if stt == ST_WARN:
		var xw: float = tl / T_WARN
		return LEAN_DEG * (LEAN_FAST * (1.0 - pow(1.0 - clampf(xw / LIFT_TOP, 0.0, 1.0), 3.0))
			+ (1.0 - LEAN_FAST) * clampf((xw - LIFT_TOP) / (1.0 + T_REAR / T_WARN - LIFT_TOP), 0.0, 1.0))
	if stt == ST_REAR or stt == ST_SLAM:
		return LEAN_DEG * (1.0 - smoothstep(-0.08, 0.02, tl))
	return 0.0


## 惯性拖尾的一步积分(见文件头 INERTIA_* 的长注)。
## ★角速度从**姿态函数自己**求数值导数 —— 不另开一套手抄的速度表(手抄的副本必然漂)。
func _inertia_step(t: Dictionary, delta: float) -> void:
	if delta <= 0.0:
		return
	var h := 1.0 / 60.0
	var ts: float = float(t["ts"])
	var now: Array = _phase_at(t, ts)
	var bef: Array = _phase_at(t, maxf(ts - h, 0.0))
	var omega: float = (float(now[2]) - float(bef[2])) / h      # 梢端基准角的角速度(度/秒)
	var gain: float = INERTIA_GAIN_SLAM if int(t["state"]) == ST_SLAM else 1.0
	var target: float = -INERTIA_MAXLAG * gain * tanh(omega / INERTIA_OMEGA_REF)
	var lag: float = float(t.get("lag", 0.0))
	var vel: float = float(t.get("lag_v", 0.0))
	## 半隐式欧拉 + 步长细分: delta 大时(慢机器/时停恢复)显式积分会发散
	var n: int = clampi(int(ceil(delta / 0.008)), 1, 8)
	var dt: float = delta / float(n)
	for _i in range(n):
		vel += (INERTIA_STIFF * (target - lag) - INERTIA_DAMP * vel) * dt
		lag += vel * dt
	t["lag"] = clampf(lag, -INERTIA_MAXLAG * 2.2, INERTIA_MAXLAG * 2.2)
	t["lag_v"] = vel

## ★★★【触地: 沿地面摊开, 不许扎进去】(2026-08-21 用户:「拍下去的时候鞭子有一部分直接在地下了」)
## 原来 `_rebuild` 里是 `if pos.y < root3.y - 0.4: pos.y = root3.y - 0.4  # 别扎穿地板太多`
## —— **它允许扎进地下 0.4**。探针实测: 下砸末到起身头 0.2 秒, 9 个站点里 3 个在地面以下,
## 最深 0.40(梢端 −0.34, 地面 0.06)。不是溢出, 是当初就这么设计的。
##
## 【为什么不能只把 0.4 改成 0】硬钳 y 会把那几段挤在同一个高度上, 步长 ds 白走了
##   ⇒ 弧长不再守恒, 触地那一截会缩成一坨。
## 【真鞭子怎么做】打到地面会**沿着地面摊开** ⇒ 触地时把切向的向下分量清零再归一化:
##   方向改成贴地走, |tan| 仍是 1, 弧长精确守恒, 多出来的长度自然摊在地面上。
## 门禁 `verify_tentacle_soft` 焊住这条(反向验证退回旧写法: 7 个点在地下、最深 0.400)。

## 触手所在的局部标架(根部世界点 / 前 / 侧 / 上)。
## ★从 `_rebuild` 抽出来 —— 那个函数第三次撞架构预算的 250 行上限。
func _basis_of(from2: Vector2, to2: Vector2) -> Array:
	var d2: Vector2 = to2 - from2
	if d2.length() < 1.0:
		d2 = Vector2.RIGHT
	var dir2: Vector2 = d2.normalized()
	var nrm2 := Vector2(-dir2.y, dir2.x)
	var root3: Vector3 = battle._world_pos(from2, battle.GROUND_LIFT)
	var wa: Vector3 = battle._world_pos(from2 + dir2 * 100.0, battle.GROUND_LIFT)
	var wn: Vector3 = battle._world_pos(from2 + nrm2 * 100.0, battle.GROUND_LIFT)
	return [root3, (wa - root3).normalized(), (wn - root3).normalized(), Vector3.UP]


## 每点半径(旧 `_tent_rows` 的式子原样, 只去掉逐帧粗细起伏那一项)。u = 沿长 0 根 … 1 梢。
func _radii(stt: int, ts: float) -> PackedFloat32Array:
	var out := PackedFloat32Array()
	for sidx in range(SEG + 1):
		var u: float = float(sidx) / float(SEG)
		## 抻直度在纺锤(蜷着 = 团)与锥(抻直 = 鞭)之间连续插值(2026-08-05 用户「整套动作都用的相同建模」)
		var taper: float = lerpf(R_BASE, R_TIP, pow(u, 0.85))
		## ★2026-10-31(主会话转用户意见): 蜷着时用纺锤(中段鼓)⇒ 待机那只高拱读成粗笨的一坨; 粗细一律走锥度(根粗梢细, 梢端细),
		##   抻直程度只影响下面那一行整体倍率(待机 ×1.75 / 拍击 ×3.01)。旧式子: r = lerp(纺锤 R_BASE·(0.42+0.58·sin(πu)^0.72), 锥度, smoothstep(抻直度))。
		var r: float = taper
		## 沿长度确定性起伏(官方轮廓是毛的) / 根部收窄(从地里钻出来) / 粗细随抻直度(待机 ×1.75, 拍击 ×1.72 倍于待机)
		if u < 0.10:
			r *= 0.42 + 0.58 * (u / 0.10)
		## ★2026-10-31(主会话转用户意见「拍下那一刻退化成一根又直、又粗的管子, 不像同一根触手」): 原来抻直时 ×3.01(待机 ×1.75),
		##   拍击带宽包络再 ×1.36 峰值 ⇒ 拍下时粗到待机的 2.3 倍。改成粗细与待机同一套(×1.75), 包络只留三成起伏。
		## 2026-11-01 用户「现在是太细了，要粗一点」: 1.75 → 2.4
		r *= 2.4
		if stt == ST_RECOVER:
			var _te: float = T_SLAM + ts
			var _bl: float = clampf(ts / T_RECOVER, 0.0, 1.0)
			r *= lerpf(lerpf(1.0, W_PEAK * _env(SLAM_W_CURVE, _te), 0.3), 1.0, pow(_bl, 3.0))
		if stt == ST_SLAM:
			r *= lerpf(1.0, W_PEAK * _env(SLAM_W_CURVE, ts), 0.3)
		## 梢端收成尖
		if u > 0.86:
			r *= 1.0 - 0.86 * pow((u - 0.86) / 0.14, 1.4)
		out.append(r)
	return out


## 场上现有几根（给门禁与调试用）
func count(side: String = "") -> int:
	if side == "":
		return _tents.size()
	var n := 0
	for k in _tents:
		if str((_tents[k] as Dictionary)["side"]) == side:
			n += 1
	return n


## 调试探针：把每根触手的 `态/ts/可见` 打成一行。
## ★做时间对齐对比图时**必须有它** —— 只看截图会把"状态切换"和"演出被藏了"
##   两种完全不同的原因看成同一个现象（CLAUDE.md：断根因先写探针打数值）。
func probe() -> String:
	# ★★ST_WARN 追加在末尾(=6)，这张表也必须跟着补 —— 漏补的话探针把整整 33 帧的【预警】显示成 "IDL"。
	var names := ["EM", "IDL", "REAR", "SLAM", "REC", "RET", "WARN"]
	var out: Array = []
	for k in _tents:
		var t: Dictionary = _tents[k]
		var mi = t.get("mi", null)
		out.append("%s=%s/%.2f/mi%s" % [k, (names[int(t["state"])] if int(t["state"]) < names.size() else "?%d" % int(t["state"])), float(t["ts"]),
			"1" if (is_instance_valid(mi) and (mi as MeshInstance3D).visible) else "0"])
	return " ".join(out)


## 结构化探针(门禁 / 逐帧直播对账读): 每根触手一条 ——
##   状态 / 计时 / 这一击的分量 / 中心线控制点(相对根部, 就是喂给着色器的那一份) / 露出比例 / 白闪 / 拍痕 /
##   网格与材质的资源身份(固定网格: 整局不换、所有触手同一份)。
func probe_data() -> Array:
	var out: Array = []
	for k in _tents:
		var t: Dictionary = _tents[k]
		var mi = t.get("mi", null)
		var mesh_iid := 0
		var mesh_rid := 0
		var mat_iid := 0
		if is_instance_valid(mi):
			var ms: Mesh = (mi as MeshInstance3D).mesh
			if ms != null:
				mesh_iid = ms.get_instance_id()
				mesh_rid = ms.get_rid().get_id()
			var mo = (mi as MeshInstance3D).material_override
			if mo != null:
				mat_iid = (mo as Object).get_instance_id()
		out.append({"key": k, "side": str(t["side"]), "idx": int(t["idx"]),
			"state": int(t["state"]), "ts": float(t["ts"]), "share": float(t.get("share", 1.0)),
			"ctrl_pts": t.get("mv_pts", PackedVector3Array()), "ctrl_r": t.get("mv_r", PackedFloat32Array()),
			"center": t.get("center", PackedVector3Array()), "root3": t.get("root3", Vector3.ZERO),
			"flash": float(t.get("mv_flash", 0.0)), "trail": float(t.get("mv_trail", 0.0)),
			"mesh_iid": mesh_iid, "mesh_rid": mesh_rid, "mat_iid": mat_iid, "node": mi})
	return out


## 当前状态已经走了多久(秒)。验收场景要按"SLAM 的第几秒"记账, 拿墙钟对不上时停/慢放。
func slam_ts_of(side: String, idx: int) -> float:
	var k: String = "%s|%d" % [side, idx]
	return float((_tents[k] as Dictionary).get("ts", 0.0)) if _tents.has(k) else 0.0


## 预警带现在可见吗。★读的是**真节点的 visible**, 不是重推状态机。
func warn_visible_of(side: String, idx: int) -> bool:
	var k: String = "%s|%d" % [side, idx]
	if not _tents.has(k):
		return false
	var mi = (_tents[k] as Dictionary).get("warn_mi", null)
	return is_instance_valid(mi) and (mi as MeshInstance3D).visible


## 预警带【真正画出来的】颜色 —— 从已建好的网格里读顶点色, 不是回读常量。
## ★为什么不直接给常量: 验收要证明的是"屏幕上这一条是蓝的", 回读 `WARN_COL_ALLY`
##   只能证明"我写了个蓝常量"(memory [[fb-gate-must-measure-requirement-not-my-hook]])。
## 取带子中心那一圈里最不透明的那个顶点(边缘顶点 alpha 渐隐到 0, 取到会得到假色)。
func warn_color_of(side: String, idx: int) -> Color:
	var k: String = "%s|%d" % [side, idx]
	if not _tents.has(k):
		return Color(0, 0, 0, 0)
	var mi = (_tents[k] as Dictionary).get("warn_mi", null)
	if not is_instance_valid(mi):
		return Color(0, 0, 0, 0)
	var msh: ArrayMesh = (mi as MeshInstance3D).mesh
	if msh == null or msh.get_surface_count() == 0:
		return Color(0, 0, 0, 0)
	var arr: Array = msh.surface_get_arrays(0)
	var cols = arr[Mesh.ARRAY_COLOR]
	if cols == null or cols.size() == 0:
		return Color(0, 0, 0, 0)
	var best: Color = Color(0, 0, 0, 0)
	for c in cols:
		if (c as Color).a > best.a:
			best = c
	return best


func state_of(side: String, idx: int) -> int:
	var k: String = _key(side, idx)
	return int((_tents[k] as Dictionary)["state"]) if _tents.has(k) else -1


## 换路 / 战斗结束：立刻撤干净（不走 RETRACT 动画 —— 场景要清空了）
func clear() -> void:
	for k in _tents:
		# ★★2026-08-04：这里原来漏了 `warn_mi` ⇒ **换路/清场每次泄漏一个预警带节点**。
		#   症状极隐蔽：泄漏的节点占着 "TentacleWarn_left_0" 这个名字，
		#   下一根触手新建的同名节点被 Godot 自动改名成 `@TentacleWarn_left_0@…`，
		#   于是按名字找节点的代码（门禁）**找到的是那个已隐藏的旧节点** ——
		#   报出来是"预警带没建出来"，实际是建了两个、找错了一个。
		for kk in ["mi", "warn_mi", "smear_mi"]:
			var n = (_tents[k] as Dictionary).get(kk, null)
			if is_instance_valid(n):
				n.queue_free()
	_tents.clear()
