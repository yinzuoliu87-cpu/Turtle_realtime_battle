func ensure(side: String, n: int) -> void:
	if preview_lock:
		return
	for idx in range(4):
		var k: String = _key(side, idx)
		var has: bool = _tents.has(k)
		if idx < n and not has:
			_spawn(side, idx)
		elif idx >= n and has:
