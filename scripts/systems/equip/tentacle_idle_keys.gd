## 每个关键帧存成 6 个「通道」: 第 0 个 = 根部角度, 第 j 个 = 第 j 段相对第 j−1 段弯了多少(弯折角, 先收进 ±180)。
## 每个通道各自沿时间展开(相邻关键帧差不超过 180°), 每一帧从根部把弯折角累加出整根。
## 11-13 用户「有点非正常扭动的时候」: 原来是每一帧临时沿身长「挑最近方向」接相邻两段 —— 相邻两段差到 ~180° 时
##   这个选择在相邻两帧之间来回翻, 那一段整个绕到另一边(实测梢端 1/3 在 1~2 帧内 2000~5000°/秒, 平常几十度)。
##   现在弯折角是关键帧里定死的、沿时间平滑过渡, 不再每帧临时挑方向 ⇒ 不会突然绕过去。
static var _k: Array = []


static func _prep() -> void:
	_k = []
	for i in range(KEYS.size()):
		var raw: Array = KEYS[i][1]
		var row: Array = [float(raw[0])]
		## 弯折角 = 关键姿势里相邻控制点的原差值(拟合出来、和标注对上的就是这个形状), 不收进 ±180、也不按上一帧补整圈。
		##   11-13 夜: 原来先收进 ±180 再按上一帧接续 ⇒ 12→13 秒第 4 通道 −107.8 → +104.1 被接成 −255.9(多绕一圈),
		##   之后半个循环这段身子都多一圈, 一整圈净转 −360 ⇒ 出土交给待机后(待机时钟正好在第 2 圈)梢端一直打折、和自己交叉,
		##   游戏里待机和关键姿势平均差 0.05–0.06(出土那几张只差 0.013)。弯折原值全在 ±141° 以内, 不会有一帧跳
		for j in range(1, raw.size()):
			row.append(float(raw[j]) - float(raw[j - 1]))
		## 根部角(整根的朝向)按上一帧接续: 整根转 360° 形状不变, 只为时间上连续
		if i > 0:
			var pv: Array = _k[i - 1][1]
			var v: float = float(row[0])
			while v - float(pv[0]) > 180.0:
				v -= 360.0
			while float(pv[0]) - v > 180.0:
				v += 360.0
			row[0] = v
		_k.append([float(KEYS[i][0]), row])


static func period() -> float:
	return PERIOD


## 控制点 j 在时刻 tl(秒, 自动循环)的角度。循环 Catmull-Rom; 跨循环接缝时把首尾差的整圈数补上。
static func _ctrl_at(tl: float, j: int) -> float:
	if _k.is_empty():
		_prep()
	var n: int = _k.size()
	var t: float = fposmod(tl, PERIOD)
	var i: int = n - 1
	for k in range(n):
		var tk: float = float(_k[k][0])
		var tn: float = float(_k[(k + 1) % n][0]) if k + 1 < n else PERIOD
		if t >= tk and t < tn:
			i = k
			break
	var t0: float = float(_k[i][0])
	var t1: float = float(_k[i + 1][0]) if i + 1 < n else PERIOD
	var s: float = clampf((t - t0) / maxf(t1 - t0, 0.001), 0.0, 1.0)
	var p0: float = _val(i - 1, j)
	var p1: float = _val(i, j)
	var p2: float = _val(i + 1, j)
	var p3: float = _val(i + 2, j)
	## 已经播完几整圈: 这个通道一整圈的净转角乘上圈数 ⇒ 跨循环接缝时数值连续
	##   (11-13 实测: 只在一圈之内连续的话, 接缝那一刻某一段弯折角跳 360°, 累加出来的整根在 0.1 秒里绕一圈)
	var laps: float = floor(tl / PERIOD)
	return laps * _cycle(j) + 0.5 * (2.0 * p1 + (p2 - p0) * s + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * s * s + (-p0 + 3.0 * p1 - 3.0 * p2 + p3) * s * s * s)


## 通道 j 一整圈的净转角(末帧 → 首帧按最近方向接回去之后, 首尾差的整圈数 × 360)
static func _cycle(j: int) -> float:
	var n: int = _k.size()
	var last: float = float(_k[n - 1][1][j])
	var first: float = float(_k[0][1][j])
	var off: float = first - last
	while off > 180.0:
		off -= 360.0
	while off < -180.0:
		off += 360.0
	return (last + off) - first


## 第 k 个关键帧(可越界、自动循环)的控制点 j: 越界时加上整个循环的净转角, 保证跨接缝也连续
static func _val(k: int, j: int) -> float:
	var n: int = _k.size()
	var wrap: int = int(floor(float(k) / float(n)))
	var kk: int = k - wrap * n
	var v: float = float(_k[kk][1][j])
	return v + _cycle(j) * float(wrap)


## 身长位置 u(0 根 … 1 梢)在时刻 tl 的方向角(度)。每一段时间往后推 LAG_U × u(头慢半拍)。
static func angle_at(tl: float, u: float) -> float:
	var t: float = tl - LAG_U * u
	var m: int = U.size()
	if u <= float(U[0]):
		return _ctrl_at(t, 0)
	## 根部角度 + 逐段弯折角累加出 6 个控制点, 再沿身长 Catmull-Rom
	## (11-13: 原来逐段 smoothstep ⇒ 控制点处角度变化为 0、弯曲全挤在两点中间 ⇒ 线上一个个硬折角; LoL 的都是平滑弧)
	var c: Array = []
	var acc := 0.0
	for j in range(m):
		acc += _ctrl_at(t, j)
		c.append(acc)
	for j in range(m - 1):
		var ua: float = float(U[j])
		var ub: float = float(U[j + 1])
		if u <= ub:
			var w: float = (u - ua) / (ub - ua)
			var p0: float = float(c[maxi(j - 1, 0)])
			var p1: float = float(c[j])
			var p2: float = float(c[j + 1])
			var p3: float = float(c[mini(j + 2, m - 1)])
			return 0.5 * (2.0 * p1 + (p2 - p0) * w + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * w * w + (-p0 + 3.0 * p1 - 3.0 * p2 + p3) * w * w * w)
	return float(c[m - 1])


## 身长位置 u 在时刻 tl 的侧偏角(度)。同样沿身长滞后 LAG_U × u(转身也是从根部带到梢端)。
## 11-13 晚: 待机姿势是在正对镜头的平面里从标注反推的, 侧偏关键帧(YAW_KEYS)是我早先自己设计、没量过的 ——
##   它把外圈往镜头转 55–85° ⇒ 圈侧过来看着变窄(用户「出土那后面几帧怎么回事」: LoL 那里是一个又圆又大的圈)。不再叠侧偏。
const USE_YAW := false


static func yaw_at(tl: float, u: float) -> float:
	if not USE_YAW:
		return 0.0
	return _yaw_at_keys(tl, u)


static func _yaw_at_keys(tl: float, u: float) -> float:
	var t: float = fposmod(tl - LAG_U * u, PERIOD)
	var n: int = YAW_KEYS.size()
	var i: int = n - 1
	for k in range(n):
		var tn: float = float(YAW_KEYS[k + 1][0]) if k + 1 < n else PERIOD
		if t >= float(YAW_KEYS[k][0]) and t < tn:
			i = k
			break
	var t0: float = float(YAW_KEYS[i][0])
	var t1: float = float(YAW_KEYS[i + 1][0]) if i + 1 < n else PERIOD
	var s: float = clampf((t - t0) / maxf(t1 - t0, 0.001), 0.0, 1.0)
	var a: Array = YAW_KEYS[(i - 1 + n) % n][1]
	var b: Array = YAW_KEYS[i][1]
	var c: Array = YAW_KEYS[(i + 1) % n][1]
	var d: Array = YAW_KEYS[(i + 2) % n][1]
	var m: int = U.size()
	var j: int = m - 1
	for jj in range(m - 1):
		if u <= float(U[jj + 1]):
			j = jj
			break
	var w: float = 0.0 if u <= float(U[0]) else clampf((u - float(U[j])) / (float(U[mini(j + 1, m - 1)]) - float(U[j]) + 0.0001), 0.0, 1.0)
	var out := 0.0
	for side in range(2):
		var jj2: int = mini(j + side, m - 1)
		var p0: float = float(a[jj2])
		var p1: float = float(b[jj2])
		var p2: float = float(c[jj2])
		var p3: float = float(d[jj2])
		var v: float = 0.5 * (2.0 * p1 + (p2 - p0) * s + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * s * s + (-p0 + 3.0 * p1 - 3.0 * p2 + p3) * s * s * s)
		out += v * (1.0 - w if side == 0 else w)
	return out

