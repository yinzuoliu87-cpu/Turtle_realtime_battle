class_name BattleCam
extends RefCounted
## 对局镜头的唯一事实源: 俯角 / 视距 / 视场角 / 注视点。别处一律从这里推, 不许再手写 (0,28,22) 这类机位数。
##
## ★俯角 40°(2026-11-16 定, 原 51°):
##   用户 11-15「不是更陡吧，就是更平着看」, 11-16 看完五档(51/45/40/35/30°)问「咩咩启示录用的是哪个角度」,
##   又说「我只想要跟它一样的这个角度就好了」。
##   量法: 平放在地上的圆, 画面上 高÷宽 = sin(俯角)。咩咩启示录 Steam 官方地牢战斗截图里那个贴地白圈,
##   程序沿外缘拟合 宽 115 高 73 ⇒ 39.5°, 位置偏上修正后 ≈ 40°(±1°); 同一把尺子量我们自己 51° / 40° 的镜头
##   量出 51.0° / 40.3°。
##   只改角度: 视距、视场角、注视点都是 51° 时代的原值(用户「只想要跟它一样的这个角度」, 拉近那几版不要)。
##
## GDScript 的 const 不能调 sin(), 所以 SIN_P / COS_P 写成字面值; verify_battle_camera 守它们 = sin/cos(PITCH_DEG)。

const PITCH_DEG := 40.0
const FOV := 40.0                                    ## 竖直视场角(KEEP_HEIGHT)
const TARGET := Vector3(0.0, 0.6, 0.0)               ## look_at 目标; 缩放 = 沿视轴向它推拉
const DIST := 35.13915                               ## 视距 = √(27.4² + 22²), 51° 时代的原值, 改俯角时没动
const SIN_P := 0.6427876                             ## sin(40°): 贴地的东西前后向在屏幕上压成这么多
const COS_P := 0.7660444                             ## cos(40°): 立着的东西(世界竖直)在屏幕上剩这么多
## 默认机位 = 注视点 + 视距 × (0, sin, cos)
const POS := Vector3(0.0, 0.6 + DIST * SIN_P, DIST * COS_P)
## 镜头前向(单位向量, 从机位指向注视点)。拿不到相机的进程(裁判机)用它
const FORWARD := Vector3(0.0, -SIN_P, -COS_P)
