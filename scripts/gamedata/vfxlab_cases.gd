## 取一份合并了缺省值的配置。未登记的 id 也能跑 —— 回落到 DEFAULT, 只是配得不准。
static func get_case(id: String) -> Dictionary:
	var out: Dictionary = DEFAULT.duplicate(true)
	var c: Dictionary = CASES.get(id, {})
	for k in c:
		out[k] = c[k]
	if str(out.get("eq", "")) == "":
		out["eq"] = id
	out["_case_id"] = id
	out["_registered"] = CASES.has(id)
	return out


## 已登记的 case 键名(供 `VFXLAB_CASE=list` 打印)。
static func ids() -> Array:
	var a: Array = CASES.keys()
	a.sort()
	return a
