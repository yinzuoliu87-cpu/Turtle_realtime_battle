extends RefCounted
class_name EquipReadouts
## equip_readouts.gd — 局内【装备格读数】的两张纯数据表(2026-08-11 从战斗主文件搬出)
##
## ══════════════════════════════════════════════════════════════════
##  这里是什么
## ══════════════════════════════════════════════════════════════════
## 玩家头像下方那一排装备图标, 每格能挂两种读数:
##   · `COUNT`  —— 右下角的**层数徽章**(整数, 如硬化层/吐息层/刻痕)
##   · `CHARGE` —— 格子上的**充能进度条**(0~满值, 如法力条/蓄力条)
##
## ★用户 2026-08-08 定的铁律:「充能条和层数**不要放头顶**, 在装备图标框里」。
##   所以新的读数一律往这两张表里加, **不要在演出层自造头顶条**。
##
## ★两张表的分母都只能是**常量**。上限随属性变的(如 maxHp×N%)要在系统侧
##   存一个归一化镜像(0~100)再挂进来 —— 见 081 的 `chg_pct`、068 的 `can_pct`。
##
## ══════════════════════════════════════════════════════════════════
##  为什么搬出来
## ══════════════════════════════════════════════════════════════════
## 2026-08-11 给 068 补读数时主文件 9000 → 9005 行, `arch_budget` 当场红。
## CLAUDE.md §5 判据只有一条:「不在 `_sim_step` 调用链上的, 不进主文件」,
## 并明写【纯数据 / 常量表 → `scripts/gamedata/`】—— 这两张表是 id → 字段名的
## 静态映射, 一行逻辑都没有, 本来就该在这儿。
##
## 主文件保留 `const PANEL_COUNT := EquipReadouts.COUNT` 两行别名,
## 消费侧(含测试里的 `_s.PANEL_CHARGE`)一个字都不用改。


const COUNT := {   # 头像下装备格右下角层数徽章: id → eq_state层数/计数字段 (刷新.get兜底0)
	"p2eq_034": "bear_layers",      # 大熊层
	"p2eq_013": "harden_stacks", "p2eq_014": "harden_stacks",   # 硬化层(0-20)
	"p2eq_024": "dragon_stacks",   # 吐息层(0-3)
	"p2eq_035": "coins_made",      # 本局累计产币数(原"齿轮层"已随2026-07-18改版作废·恒为0)
	"p2eq_052": "revolver_bullets", "p2eq_027": "baton_charges", "p2eq_039": "bamboo_charges",   # 子弹/电击/生长充能
	"p2eq_015": "thorn_empower",   # 荆棘海胆: 攒着的"强化下一次普攻"次数(每次普攻消费一层)
	"p2eq_019": "anemone_layers",  # 海葵层
	"p2eq_020": "exercise",       # 哑铃锻炼层(局内, 每场重置)
	"p2eq_093": "marks",           # 香火石刻痕(0-300·跨对局保留·赛季重置)
	"p2eq_017": "anchor_charges",  # 沉锚就绪充能数(另有anchor_accum攒治疗条)
	"p2eq_036": "egg_levels",      # 温泉蛋临时等级(0-3; 另有incub充能条)
	"p2eq_082": "charges",         # 护心甲充能层(每反伤 15 次一层; 普攻消耗一层)
	"p2eq_083": "stacks",          # 潮汐细剑连击层(0-20; 切目标或目标死清空)
	# ★★ 2026-08-10 补三件【系统写了、UI 没人读】的进度(与法器法力条同族)。
	#   扫 `eq_state` 写入字段 vs 本表 + PANEL_CHARGE 读取字段扫出来的:
	#   玩家在局内**完全看不到**这三件攒到哪, 而它们的效果就是"越攒越强"。
	"p2eq_065": "oil_stacks",     # 鲨肝油: 每次普攻 +1 层攻速(无限叠, 换路重置)
	"p2eq_069": "eaten",          # 珊瑚糖糕: 已吃几块(共 3 块, 80/55/30% 各一)
	#   ★拿 `eaten` 而不是 `cake_eaten_n`: 前者是**驱动逻辑的那个计数**(while 循环读它),
	#   后者注释里写明是"同步触发证据(门禁读它)" —— 拿测试专用字段做玩家读数会漂。
	"p2eq_071": "given_n",        # 炼乳罐: 本路已发奶油盾次数 1/2/3(2026-08-11 用户: 图标数字显示已提供护盾次数)
	"p2eq_074": "bone_layers",    # 鲸骨胸甲: 叠护盾层数(无上限)
	# ★弓箭批补验收(2026-08-11): 连发弩机主动的【待射发数】倒数(42→0)。
	#   镜像由 eq_bow_batch 排队时 += / _tick_volleys 逐发 −1(打空也算射出), 见 _volley_mirror_drop。
	"p2eq_076": "volley_left",    # 连发弩机: 本轮连射还剩几发
}
const CHARGE := {   # 局内头像下装备格的充能进度条: id → [充能字段, 满值]
	"p2eq_009": ["blade_energy", 100.0],
	## ★087 压载舱(2026-08-17 补): 伤害先灌进舱、舱满才真掉血 —— 玩家局内看不到攒到哪。
	##   舱容 = 最大生命 × 60/90/150%(随羁绊变) ⇒ 分母不是常量, 按本表表头的规矩
	##   在系统侧存 0~100 的归一化镜像 `ballast_pct`(同 081 的 chg_pct)。
	"p2eq_087": ["ballast_pct", 100.0, "#4fc3f7"],
	"p2eq_026": ["mana_pct", 100.0, "#a98bff"],   # 026 的雷电充能已并进法器法力条(2026-08-12)
	"p2eq_023": ["mana_pct", 100.0, "#a98bff"],   # 023 的火法力已并进法器法力条(2026-08-12), 只剩这一条
	"p2eq_017": ["anchor_accum", 250.0], "p2eq_036": ["incub", 100.0],
	## ★015 荆棘海胆(2026-08-17 补): 反伤累计满 300/270/230 → 护盾 + 强化下一次普攻。
	##   补之前它在**两张表里一个字都没有** —— 与 017 完全同构(就绪次数 + 攒进度),
	##   却只有 017 有出口。阈值随星级变 ⇒ 存归一化镜像 thorn_pct(同 081/068/087 的手法)。
	##   条色取反伤跳字的同一支棕金 Color("#c9a36b"), 与法器紫/盾绿/血蓝都区分得开。
	"p2eq_015": ["thorn_pct", 100.0, "#c9a36b"],
	# ★★盾类两件(2026-08-08 用户:「充能条和层数不要放头顶, 在装备图标框里」)
	#   081 的需求是 maxHp×40/35/30%(不是常量) ⇒ 存归一后的 chg_pct(0~100), 这张表的 cap 只能是常量;
	#   082 的分母就是常量 15 ⇒ 直接拿 refl_n。
	"p2eq_081": ["chg_pct", 100.0, "#7cf07c"], "p2eq_082": ["refl_n", 15.0, "#9ff0d8"],
	# 093 香火石: 每攒够 4000 点伤害刻一道痕 ⇒ 分母是常量 4000, 直接拿 chg。
	# ★之前这两个读数在局内**没有任何 UI 出口**(装备格全空), 玩家看不到自己攒到哪。
	"p2eq_093": ["chg", 4000.0, "#ffd27a"],
	# ★★法器【法力条】(2026-08-10): 10 件法器以前**局内零读数** ——
	#   用户:「我压根没看到装备图标那里有法力条, 在攒法力吗」。
	#   每件法器有**独立**法力条(规格原文), 所以是逐件一条而不是共用一条。
	#   分母拿 `mana_pct`(staff_synergy_system 里归一化镜像)而不是 `mana`:
	#   满值随档位变(200/180/150/120/80·档0~4), 而这张表的分母只能是常量。
	"p2eq_011": ["mana_pct", 100.0, "#a98bff"], 	"p2eq_029": ["mana_pct", 100.0, "#a98bff"], "p2eq_030": ["mana_pct", 100.0, "#a98bff"],
	"p2eq_031": ["mana_pct", 100.0, "#a98bff"], "p2eq_043": ["mana_pct", 100.0, "#a98bff"],
	"p2eq_088": ["mana_pct", 100.0, "#a98bff"], "p2eq_089": ["mana_pct", 100.0, "#a98bff"],
	"p2eq_090": ["mana_pct", 100.0, "#a98bff"],
	# ★★068 深海气压罐(2026-08-11)。由来: 用户「我记得 5 费应该有个气压瓶是吗」——
	#   查下去发现它把挨的伤害整条存进 `can_charge`, 而这张表与 PANEL_COUNT 都没有它
	#   ⇒ 局内零出口。**它正是"越攒越强"那一类, 看不见等于玩家不知道自己攒到哪。**
	#   ⚠ 上一轮(2026-08-10)注释里写着 065/069/074 是"扫 eq_state 写入字段扫出来的",
	#     但 068 没被扫出来 —— 那次是人眼扫的, 漏了。现由 `verify_eq_readouts` 用脚本守。
	#   条色取血条法力盾段的同一支蓝(hp_bar._MANA_L #9ed1ff), 与法器紫区分开: 两套机制。
	"p2eq_068": ["can_pct", 100.0, "#9ed1ff"],
	# ★★弓箭批补验收(2026-08-11)。这三件的核心机制以前局内零读数:
	#   073 藤蔓弓弦: 暴击给的 2 秒攻速 buff 挂没挂着完全不可见 ⇒ 剩余时间归一成 0~100
	#     (eq_bow_batch._vine_mirror 每帧写; 分母只能是常量, 同 081 chg_pct 的手法)。条色 = 藤蔓绿。
	"p2eq_073": ["vine_buff_pct", 100.0, "#8ce860"],
	#   075 银色箭袋: "每 6 秒一轮箭雨"的充能 —— 直接读周期计时器 iv_t(equip_system
	#     `_tick_eq_intervals` 每帧维护, 零新代码)。⚠ 分母 6.0 = EQ_IV_BATCH1["p2eq_075"],
	#     改周期要同步改这里(verify_eq_bow_batch ⑦ 焊住两者相等)。
	"p2eq_075": ["iv_t", 6.0, "#b6e86a"],
	#   076 连发弩机: 被动"每第三下普攻叠腐蚀"的进度(0/1/2, 触发那下回 0)。
	#     羁绊未激活时恒 0(eq_bow_batch.on_basic_076 压回) —— 不给玩家兑不了现的进度条。
	"p2eq_076": ["cross_step", 3.0, "#d0f06a"],
}
