shader_type spatial;
render_mode unshaded, cull_disabled;
// 潟湖水面。原来是 sin(UV.x*6.0+TIME) —— UV 是每格 0..1, 波在每格里重新开始,
// 整片水成了同一个印章排成的方阵。现在全部按世界坐标算, 并用距离场做浅→深 + 岸线泡沫。
#include "res://scripts/scenes/battle/shaders/ground_common.gdshaderinc"

// ═══ ★★2026-09-18 重做: 水体色回到硬锁规格 ═══════════════════════════
// 硬锁表(docs/design/场景地图方案.md §4)写的是【两个】色:
//     水 water: #1fb8c4   →   高光: #3fe9e0
// 而改前这里 shallow_col = (0.30,0.93,0.90) ≈ #4dede6, **几乎就是那个高光色**;
// 又因为潟湖只有 2~3 格宽 ⇒ depth 始终很低 ⇒ **整条水带被刷成高光色而不是水体色**。
// ⇒ 改成「水体=#1fb8c4, 高光只上浪尖」是**恢复规格**, 不是违反硬锁。
//
// ★为什么非改不可(34 张真实游戏内画面实测, 见 tools/battle_scene_audit.py 文件头第二张表):
//   · 本项目全屏亮部里 **86% 是这条水带**, 它同时是全屏最大的连通亮区(占窗口 17.2%, 参考中位 4.2%)
//   · 判据③ 亮部饱和度中位 本项目 0.696 / 参考 0.394(阈值 ≤0.60)
//     —— **最亮的东西该是「光」(高亮度会往白里跑, 饱和度掉), 不是一块纯色**
//   · 参考 34 张里 **0 张**同时踩中判据③④, 本项目 4/4 全踩
// ⇒ 让"光"(焦散/泡沫, 饱和度只有 0.38/0.22)去当最亮的, 水体退回中间调。
// ★★2026-09-20: 压暗且降饱和。**色相仍在 #1fb8c4 那一族(~190°), 只动明度/饱和**。
// 理由(153 帧真实游戏内画面实测, docs/studies/20260920-咩咩启示录美术逐帧-配色与结构.md):
//   · 改前水占场地区 **30.4%**、明度中位 **148**、饱和中位 **0.93** —— 比石台(139) **还亮 +9**。
//   · 同口径量: 本项目「最大高饱和中间调连通块」占 **15.65%**, 而参考 p50 只有 **0.43%**
//     (p90 2.08%) ⇒ **差 24 倍以上, 落在参考的 98.7 百分位**。那块色相中位 185°、7 成在 180~210。
//   · 参考里**水比地面暗**(可回查帧 29)。我们反过来了。
// ★★同时纠一条我自己的错结论: 2026-09-18 我拿**一帧过场镜头**量出「近中性 43% vs 2.7%
//   是最大差距」并写进决策记录。153 帧重量: 参考自己就是**高饱和**游戏(S>0.5 占 63.4%),
//   而本项目只有 48.8% —— **我们比它更不饱和, 那个方向是反的**。真正的病是【一整块】。
uniform vec4 shallow_col : source_color = vec4(0.122, 0.722, 0.769, 1.0);  // 水体 = 硬锁 #1fb8c4
uniform vec4 deep_col : source_color = vec4(0.063, 0.443, 0.486, 1.0);     // 远岸深水(同色相压暗)
// ★★改前这里写着「深色不能压太狠…否则"亮青潟湖框住暗岛"的构图会被反转」——
//   实测证明**那个构图本身就是病**: 参考 34 张里没有任何一款是"最亮的是一块饱和色"。
//   所以这一轮反过来做: 让水退回中间调, 由光去占亮部。
// ★★`body_dim`(2026-09-20): 水体的**着色压暗系数** —— 调色板原值一个像素不动。
// 「水是什么色」由硬锁调色板说了算(#1fb8c4), 「它被照得多亮」由着色说了算 ——
// 改 `shallow_col` 本身等于偻改调色板, `verify_water_palette` 会当场红(我试过, 红得对)。
//
// 理由(153 帧咩咩启示录**真实游戏内**画面实测, docs/studies/20260920-咩咩启示录美术逐帧-配色与结构.md):
//   · 参考里**水比地面暗**(可回查帧 29); 本项目改前水比石台**还亮 +10**。
//   · 改前水占场地区 30.4%、明度中位 149、饱和中位 0.93 ⇒ **一整块高饱和亮环**。
//   · 同口径: 本项目最大高饱和中间调连通块 15.65%, 参考 p50 只有 **0.43%**(p90 2.08%)。
// ★★同时纠一条我自己的错结论: 2026-09-18 我拿**一帧过场镜头**量出「近中性 43% vs 2.7%
//   是最大差距」并写进决策记录。153 帧重量: 参考自己就是**高饱和**游戏(S>0.5 占 63.4%),
//   本项目只有 48.8% ⇒ **我们比它更不饱和, 那个方向是反的**。真正的病是【一整块】。
uniform float body_dim = 0.62;
uniform vec4 crest_col : source_color = vec4(0.247, 0.914, 0.878, 1.0);    // 浪尖高光 = 硬锁 #3fe9e0
uniform vec4 foam_col : source_color = vec4(0.78, 1.0, 0.98, 1.0);      // 岸线泡沫
uniform sampler2D detail_tex : filter_nearest, source_color;
uniform float detail_amt = 0.45;
uniform float tex_scale = 0.32;
uniform float depth_steps = 4.0;    // placeholder
// 岸线切角用的陆色(取淤泥/石的中间调 —— 岸边多半是这两种)
uniform vec4 shore_land_col : source_color = vec4(0.135, 0.175, 0.29, 1.0);    // 水深量化成几级(级数少=像素画; 多=糊成渐变)

void fragment() {
	vec2 wp = world_xz(INV_VIEW_MATRIX, VERTEX);
	float d = shore_sdf(wp);                       // >0 在水里, 单位=格

	// ── 浅→深: 按离岸距离分级 + 抖动 ────────────────────────────────
	// ★分级而不是平滑: 平滑渐变在这套低色数配色下必出条带; 分 4 级再抖动才是像素画的做法。
	// ★★2026-09-18 斜率收紧 (0.45,2.9) → (0.15,1.5):
	//   潟湖只有 2~3 格宽, 而 smoothstep 到 2.9 格才吃满 ⇒ 改前**整条带的 depth 都很低**,
	//   于是整条带都取靠岸色(明度 140) ⇒ 水体天然压在"亮部"门槛 130 之上, 且饱和 0.85。
	//   实测: Y130~150 这一层占窗口 10.4%、饱和中位 0.854 —— 判据③ 就卡在这里。
	//   ★不加臆造的压暗系数, 用现成的水深模型: 收紧斜率 ⇒ 带心读作深水(明度 85),
	//     只有贴岸的一两个像素还是 #1fb8c4 —— 这正是硬锁表里"水体/高光"该有的分工。
	float depth = dither_steps(smoothstep(0.15, 1.5, d), depth_steps, FRAGCOORD.xy);
	vec3 c = mix(shallow_col.rgb, deep_col.rgb, depth) * body_dim;   // ★压暗在这里, 不在调色板里

	// ── 波纹(世界坐标·跨格连续) ────────────────────────────────────
	// 浅水波纹更明显、深水几乎平静 —— 真实水体就是这样, 也让"深浅"读得更清楚。
	float w = sin(wp.x * 2.2 + TIME * 1.2) * 0.5 + 0.5;
	w = mix(w, sin(wp.y * 1.8 - TIME * 0.9) * 0.5 + 0.5, 0.5);
	// ★改前是 `mix(c, shallow_col, w*0.30)` —— 把【整条带】往亮里推(shallow 那时就是高光色),
	//   所以水面没有"浪尖"只有"整片亮"。现在 pow 收窄成真正的尖: w=1 附近才上高光。
	float crest = pow(w, 4.0);
	// ★2026-09-20: 0.55→0.30 —— 浪尖/泡沫的强度是当初对着**亮水体**标定的,
	//   水体压暗后同样强度的对比度翻倍 ⇒ 岸线变成一条发光描边环。
	c = mix(c, crest_col.rgb, crest * 0.30 * (1.0 - depth * 0.75));

	// ── 岸线泡沫 ──────────────────────────────────────────────────
	// 一条沿岸线的亮带, 宽度被一个低频正弦揉过 → 不是死板的等距轮廓线。
	// ★改前水陆是【硬切】: 亮青(98)直接怼上暗淤泥(32), 中间零过渡 —— 全图最不"精美"的地方。
	float wob = sin(wp.x * 3.1 + wp.y * 2.3 + TIME * 0.8) * 0.10;
	float foam = 1.0 - smoothstep(0.0, 0.34 + wob, d);   // 越靠岸越强
	foam *= smoothstep(-0.10, 0.06, d);                  // 别糊到陆地上去
	foam = dither_steps(foam, 3.0, FRAGCOORD.xy);        // 泡沫也分级抖动, 免得成一条羽化的模糊带
	// ★强度 0.22 不是 0.55: 第一版 0.55 + 宽 0.62 让泡沫成了【霓虹描边】,
	//   整座岛像套了个发光环。泡沫是"水拍岸的白边", 该是提示不是主角。
	// ★★2026-09-18 0.22 → 0.46(★宽度仍是 0.34, 没回到当年被否的 0.62):
	//   实拍热点图(scratchpad/u1/w2_hotmap.png)显示, 压完水体之后**唯一剩下的问题像素
	//   是沿岛一圈的岸线亮边** —— 它是靠岸色 #1fb8c4(明度 140·饱和 0.83)本身。
	//   判据③ 要"最亮的是光不是纯色", 而现实里岸边那条亮线本来就该是**白色泡沫**。
	//   foam_col (0.78,1.0,0.98) 饱和只有 0.22 ⇒ 提权重 = 把那条边从"饱和水色"换成"白边"。
	//   ⚠ 当年被否的是【宽 0.62 + 强 0.55】那个组合(整座岛套发光环), 这里只动强度不动宽度;
	//     改完必须**同时看实拍**确认没成霓虹描边, 光看数字不算。
	vec3 c_pre_foam = c;
	c = mix(c, foam_col.rgb, foam * 0.18);   // ★2026-09-20: 0.46→0.18(同上理由·只动强度不动宽度)

	// ── 细节纹(世界坐标) ──────────────────────────────────────────
	float det = texture(detail_tex, wp * tex_scale).r;
	c *= mix(1.0, det, detail_amt * (1.0 - depth * 0.4));

	// ── 焦散: 浅水最亮, 深水几乎没有(光透不下去) ──────────────────
	if (rich_fx) {
		float ca = dither_steps(caustics(wp * 0.5, TIME * caustic_speed), 3.0, FRAGCOORD.xy);
		c += caustic_col.rgb * ca * caustic_amt * (1.0 - depth * 0.8);
	}

	// ── ★★岸线【切角】(与 ground_land 对称) ────────────────────────
	// 砖的直角边被距离场的零等值线斜切掉; 两个 shader 各画自己那一半, 拼起来就是一条平滑岸线。
	float lmask = dither_steps(1.0 - smoothstep(-0.06, 0.14, d), 2.0, FRAGCOORD.xy);
	c = mix(c, shore_land_col.rgb, lmask);

	// ── 岛缘压暗: 越靠板子外沿越暗(照不到光) ────────────────────
	// 同样过抖动分级, 免得出现一圈羽化的模糊晕。
	float ef = dither_steps(smoothstep(0.02, 0.60, edge_fade(wp)), 4.0, FRAGCOORD.xy);
	// ★系数 0.18 而不是 0.34: 场景开着雾, 而【雾是叠加的】——
	// 乘性压暗会被雾底冲淡, 探针实测 0.34 只做到 13% 的实际压暗(30→26)。
	c *= mix(0.18, 1.0, ef);

	ALBEDO = c;
	// ★自发光按【泡沫之前】的颜色算 —— 否则泡沫会被二次放大成光晕。
	// ★★0.26 → 0.09: 26% 的自发光是"整条水带明度 176"的一大来源(水体色明度才 140)。
	//   判据③ 要的是"最亮的是光不是水", 水自己发光正好反着来。
	//   ⚠ 这个数和 caustic_amt 是一对: 压水的同时要把光提上去, 否则整体只是变暗。
	EMISSION = c_pre_foam * 0.0;   // ★2026-09-20: 0.09→0 —— 自发光让水拿不到「比地面暗」
}
